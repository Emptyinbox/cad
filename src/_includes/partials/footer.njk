{% from "partials/icon.njk" import icon %}
<footer class="site-footer">
  <div class="container">
    <div class="site-footer__grid">

      <div class="site-footer__col site-footer__brand">
        <span class="site-footer__logo">{% include "partials/cad-logo.svg" %}</span>
        <p>{{ site.description }}</p>
        <div class="site-footer__social">
          <a href="{{ site.social.linkedin }}" aria-label="LinkedIn" target="_blank" rel="noopener">{{ icon("linkedin", 20) }}</a>
          <a href="{{ site.social.facebook }}" aria-label="Facebook" target="_blank" rel="noopener">{{ icon("facebook", 20) }}</a>
        </div>
      </div>

      <div class="site-footer__col">
        <h4>Services</h4>
        <ul>
          {% for s in services %}<li><a href="/{{ s.slug }}/">{{ s.title }}</a></li>{% endfor %}
        </ul>
      </div>

      <div class="site-footer__col">
        <h4>Locations</h4>
        <ul>
          {% for province, info in locations | dictsort %}
            {% for city in info.cities %}
            <li><a href="/locations-served/{{ province }}/{{ city.slug }}/">{{ city.title }}</a></li>
            {% endfor %}
          {% endfor %}
        </ul>
      </div>

      <div class="site-footer__col">
        <h4>Get in touch</h4>
        <ul class="site-footer__contact">
          <li>{{ icon("headset", 16) }} <a href="tel:{{ site.phonePrimaryHref }}">{{ site.phonePrimary }}</a></li>
          <li>{{ icon("envelope", 16) }} <a href="mailto:{{ site.email }}">{{ site.email }}</a></li>
          <li>{{ icon("pin", 16) }} {{ site.address.city }}, {{ site.address.region }}</li>
        </ul>
        <a href="/contact-us/" class="btn btn--primary btn--small" style="margin-top:1rem;">Get a quote {{ icon("arrow-right", 14) }}</a>
      </div>

    </div>

    <div class="site-footer__bottom">
      <p>&copy; {{ "" | year }} {{ site.name }}. Built with care in BC.</p>
      <p><a href="/privacy-policy/">Privacy Policy</a></p>
    </div>
  </div>
</footer>

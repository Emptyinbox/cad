{% from "partials/icon.njk" import icon %}
<section class="section section--paper">
  <div class="container">
    <div class="section-head">
      <span class="section-head__eyebrow">{{ icon("check", 14) }} Why teams pick us</span>
      <h2>The good kind of <span class="accent-italic">predictable.</span></h2>
      <p>You shouldn't have to think about your IT. That's our job.</p>
    </div>
    <div class="grid grid--2">
      {% for item in home.whyUs %}
      <div class="why-card">
        <div class="why-card__icon">{{ icon(item.icon, 28) }}</div>
        <div>
          <h3>{{ item.title }}</h3>
          <p>{{ item.body }}</p>
        </div>
      </div>
      {% endfor %}
    </div>
  </div>
</section>

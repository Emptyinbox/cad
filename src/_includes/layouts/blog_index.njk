---
layout: layouts/base.njk
---
{% from "partials/icon.njk" import icon %}

<header class="page-header">
  <div class="container">
    <div class="page-header__breadcrumb"><a href="/">Home</a> / Blog</div>
    <h1>Field notes from the <span class="accent-italic">IT trenches.</span></h1>
    <p class="page-header__lede">Plain-English writing about cybersecurity, small-business IT, and the weird ways software breaks. No clickbait, no jargon.</p>
  </div>
</header>

<section class="section">
  <div class="container">
    <div class="grid grid--2">
      {% for post in collections.posts %}
      <a href="{{ post.data.permalink }}" class="card">
        <div class="card__icon">{{ icon("sparkle", 28) }}</div>
        <h3>{{ post.data.title }}</h3>
        <p style="color: var(--ink-mute); font-size: .9rem; margin-bottom: .35rem; text-transform: uppercase; letter-spacing: 0.06em; font-weight: 600;">{{ post.data.date | readableDate }}</p>
        <p>{{ post.data.description }}</p>
        <span class="card__more">Read post {{ icon("arrow-right", 16) }}</span>
      </a>
      {% endfor %}
    </div>
  </div>
</section>

{% include "partials/cta.njk" %}

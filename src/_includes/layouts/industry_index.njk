---
layout: layouts/page.njk
---
{{ content | safe }}
<section class="section section--alt">
  <div class="container">
    <div class="grid grid--3">
      {% for ind in industries %}
      <a href="/industries/{{ ind.slug }}/" class="card">
        <div class="card__icon"><i class="{{ ind.icon }}"></i></div>
        <h3>{{ ind.title }}</h3>
        <span class="card__more">Learn more <i class="fas fa-arrow-right"></i></span>
      </a>
      {% endfor %}
    </div>
  </div>
</section>

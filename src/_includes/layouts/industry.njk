---
layout: layouts/base.njk
---
{% from "partials/icon.njk" import icon %}
{% from "partials/related.njk" import related %}

{% set currentSlug = page.fileSlug %}
{% set ind = industries | findBySlug(currentSlug) %}

<header class="page-header page-header--rich">
  <div class="container">
    <div class="page-header__breadcrumb"><a href="/">Home</a> / <a href="/industries/">Industries</a> / {{ title }}</div>
    <div class="page-header__head">
      {% if ind %}<div class="page-header__icon">{{ icon(ind.icon, 36) }}</div>{% endif %}
      <div>
        <h1>IT Services for {{ title }}</h1>
        {% if description %}<p class="page-header__lede">{{ description }}</p>{% endif %}
        <div class="page-header__actions">
          <a href="/contact-us/" class="btn btn--primary">{{ icon("arrow-right", 16) }} Get a quote</a>
          <a href="tel:{{ site.phonePrimaryHref }}" class="btn btn--outline">{{ icon("headset", 16) }} {{ site.phonePrimary }}</a>
        </div>
      </div>
    </div>
  </div>
</header>

<article class="prose prose--rich" data-faq>
  {{ content | safe }}
</article>

{% include "partials/services-grid.njk" %}

{{ related("industry", currentSlug, services, industries, locations) }}

{% include "partials/cta.njk" %}
